{
  "name": "fittlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-copy.mjs && node scripts/check-weights.mjs && node scripts/check-colors.mjs && node scripts/icon-check.mjs && node scripts/check-native-navigation.mjs && npm run check:share-performance && tsx scripts/storyplan-check.mjs && node --import tsx scripts/content-safety-check.mjs && node --import tsx scripts/timezone-calendar-check.mjs && tsx scripts/calendar-atomicity-check.ts && tsx scripts/purge-check.ts && node --import tsx scripts/anonymous-rate-limit-check.ts && node scripts/email-follow-confirmation-check.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:backfill-geolocation": "tsx scripts/backfill-geolocation.ts",
    "check:copy": "node scripts/check-copy.mjs",
    "check:story": "tsx scripts/storyplan-check.mjs",
    "check:share-performance": "node --import tsx scripts/share-performance-check.mjs && node --import tsx scripts/share-content-revision-check.mjs && node --import tsx scripts/storyimage-tier3-check.mjs",
    "check:icons": "node scripts/icon-check.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "check:weights": "node scripts/check-weights.mjs",
    "check:native": "node scripts/check-native-navigation.mjs",
    "check:calendar-atomicity": "tsx scripts/calendar-atomicity-check.ts",
    "check:timezone": "node --import tsx scripts/timezone-calendar-check.mjs",
    "check:content-safety": "node --import tsx scripts/content-safety-check.mjs",
    "check:purge": "tsx scripts/purge-check.ts",
    "check:rate-limits": "node --import tsx scripts/anonymous-rate-limit-check.ts",
    "check:email-follow": "node scripts/email-follow-confirmation-check.mjs",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@electric-sql/pglite": "^0.2.17",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@vercel/blob": "^2.7.0",
    "@vercel/speed-insights": "^1.3.1",
    "drizzle-orm": "^0.41.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.27.0",
    "next": "^15.3.2",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.6",
    "playwright": "^1.61.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
