# Postgres connection string. Leave unset in development to use an embedded
# PGlite database persisted at .data/pglite.
DATABASE_URL=

# Secret for signing session cookies. Any long random string. Also derives the
# key that encrypts stored Google refresh tokens — keep it stable in prod.
SESSION_SECRET=change-me

# Resend API key. Leave unset to log emails to the console (dev mode).
RESEND_API_KEY=

# From address for outbound email (must be verified in Resend).
MAIL_FROM="fittlist <hello@fittlist.co>"

# Canonical origin of the deployed site, used in copy/links and the Google
# OAuth redirect URI (<origin>/api/google/callback).
NEXT_PUBLIC_ORIGIN=https://fittlist.co

# Google Calendar sync (optional). Leave unset to hide the feature entirely.
# Create an OAuth client in Google Cloud (Calendar API enabled) and register
# <NEXT_PUBLIC_ORIGIN>/api/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
