# Postgres connection string. Leave unset in development to use an embedded
# PGlite database persisted at .data/pglite.
DATABASE_URL=

# Secret for signing session cookies. Any long random string. Also derives the
# key that encrypts stored Google refresh tokens — keep it stable in prod.
SESSION_SECRET=change-me

# Resend API key. Leave unset to log emails to the console (dev mode).
RESEND_API_KEY=

# From address for outbound email (must be verified in Resend).
MAIL_FROM="fittlist <hello@fittlist.co>"

# Canonical origin of the deployed site, used in copy/links and the Google
# OAuth redirect URI (<origin>/api/google/callback).
NEXT_PUBLIC_ORIGIN=https://fittlist.co

# Google Calendar sync (optional). Leave unset to hide the feature entirely.
# Create an OAuth client in Google Cloud (Calendar API enabled) and register
# <NEXT_PUBLIC_ORIGIN>/api/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Beta gates
# ---------------------------------------------------------------------------

# Signups, coach and member alike. Invite-only unless explicitly disabled — an
# email must be in the invites table (or ADMIN_EMAILS) to create any account.
#   unset / anything   invite-only (the beta default)
#   false              open self-serve signup
# Signup is public. Invite links remain available for attribution.

# The member side: following coaches, the Following tab, Discover, "I'm going".
#   unset      dark. Admins can still preview it; nobody else sees it.
#   coaches    live for anyone signed in, but the public signup has no
#              "I'm here to train" option — coach-to-coach testing.
#   true       members can sign up themselves — subject to INVITE_ONLY, same
#              as coaches. Everyone is in the beta until the beta ends.
# Note the exact string: only "true" shows the role toggle on signup. Setting
# this to "1" or "yes" leaves the member signup closed.
FANS_ENABLED=

# Comma-separated emails with admin rights (/admin, and preview of dark flags).
ADMIN_EMAILS=

# Shared secret for the cron endpoints (/api/cron/weekly?key=...).
CRON_SECRET=

# Reply-To on outbound mail. A transactional email nobody can reply to is a
# spam signal, and an unanswerable sign-in email is bad manners besides.
MAIL_REPLY_TO=

# How many people each beta user may invite. Admins are never capped.
BETA_INVITES_PER_USER=5
